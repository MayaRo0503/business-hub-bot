# Copy to .env for local runs only. In production these live in Render → Environment.
# Never commit .env, never paste these values into a chat.

ADMIN_TOKEN=                 # long random string; the hub folder uses it to talk to the server
SECRET_KEY=                  # long random string; encrypts tokens connected from the dashboard. Never change it
PUBLIC_URL=                  # https URL of this server (Render sets RENDER_EXTERNAL_URL automatically)
DATABASE_URL=sqlite:///bot.db  # production: postgres://... (Neon free tier)
BOT_MODE=basic               # basic | smart
BUSINESS_NAME=

# Meta app (WhatsApp + Messenger + Instagram share one app).
# Normally connected from the dashboard instead; these env vars are optional overrides.
META_APP_ID=
META_APP_SECRET=             # App settings → Basic → App secret
META_VERIFY_TOKEN=           # any random string; the same value goes into the Meta webhook form
GRAPH_API_VERSION=v25.0
WHATSAPP_PHONE_ID=           # WhatsApp → API Setup → Phone number ID
FACEBOOK_ACCESS_TOKEN=       # System user permanent token with whatsapp_business_messaging
PAGE_ACCESS_TOKEN=           # Page token with pages_messaging (+ instagram_manage_messages)

# Telegram
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_WEBHOOK_SECRET=     # random string, A-Z a-z 0-9 _ -
OWNER_TELEGRAM_CHAT_ID=      # owner writes /myid to the bot to get it

# Smart mode
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Tuning
SESSION_TIMEOUT_MIN=30
HANDOFF_SILENCE_HOURS=12
